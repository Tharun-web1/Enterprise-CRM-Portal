# ==============================================================================
# CRM Portal Backend Environment Configuration Template
# Copy this file to '.env' and fill in your actual environment-specific secrets.
# NEVER commit your real '.env' file to Git or GitHub!
# ==============================================================================

# Django Secret Key (generate a unique, random string for production)
SECRET_KEY=django-insecure-replace-this-with-a-real-secret-key-in-production

# Debug Mode (set to False in production)
DEBUG=True

# Allowed Hosts (comma-separated domains/IPs)
ALLOWED_HOSTS=127.0.0.1,localhost

# Email SMTP Settings (e.g. Gmail SMTP with 16-character App Password)
# If left blank, Django will safely fallback to console email output in development.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-16-char-app-password
DEFAULT_FROM_EMAIL=CRM Operations <your-email@gmail.com>

# Optional Seeding Passwords (used only when running python seed_db.py in development)
# SEED_ADMIN_PASSWORD=custom_admin_password
# SEED_LEAD_PASSWORD=custom_lead_password
# SEED_DEV_PASSWORD=custom_dev_password

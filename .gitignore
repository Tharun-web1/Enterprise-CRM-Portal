# ==========================================
# CRM Portal - Git Ignore Rules
# ==========================================

# Environment variables & secrets (CRITICAL)
.env
.env.*
*.env
!.env.example
!*.env.example

# Local SQLite databases
*.sqlite3
*.sqlite3-journal
*.db
db.sqlite3

# Runtime logs
*.log
django_errors.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Uploaded User Media & Static build cache
media/*
backend/media/*
!backend/media/.gitkeep
!backend/media/*/.gitkeep

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Frontend dependencies & build output
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
*.local

# Compressed backup files & archives (CRITICAL: prevents accidental leak of code/database zips)
*.zip
*.tar
*.tar.gz
*.rar
*.7z
*.bak

# IDE & OS specific files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~
